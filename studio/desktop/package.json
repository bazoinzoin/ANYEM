{
  "name": "onde-studio-desktop",
  "productName": "Onde Studio",
  "version": "0.1.0",
  "private": true,
  "description": "Onde Studio, version Windows (Electron) : le logiciel de dist/onde-studio.html dans sa propre fenêtre.",
  "author": "Onde Studio",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "fr.onde.studio",
    "productName": "Onde Studio",
    "copyright": "Onde Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "app/**"
    ],
    "win": {
      "icon": "onde-studio.ico",
      "artifactName": "OndeStudio-${version}-windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Onde Studio",
      "artifactName": "OndeStudio-${version}-installation.${ext}"
    },
    "portable": {
      "artifactName": "OndeStudio-${version}-portable.${ext}"
    }
  },
  "repository": "https://github.com/bazoinzoin/ANYEM"
}
