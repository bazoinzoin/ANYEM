{
  "name": "anyem-desktop",
  "productName": "Anyem",
  "version": "0.3.0",
  "private": true,
  "description": "Anyem, version Windows (Electron) : le jeu de dist/anyem.html dans sa propre fenêtre.",
  "author": "Anyem",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable zip --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "fr.anyem.game",
    "productName": "Anyem",
    "copyright": "Anyem",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "game/**"
    ],
    "win": {
      "icon": "../dist/anyem.ico",
      "artifactName": "Anyem-${version}-windows.${ext}"
    },
    "portable": {
      "artifactName": "Anyem-${version}.exe"
    }
  },
  "repository": "https://github.com/bazoinzoin/ANYEM"
}
